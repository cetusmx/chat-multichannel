# --- Database ---
POSTGRES_USER=salesflow
POSTGRES_PASSWORD=salesflow_dev
POSTGRES_DB=salesflow
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?connection_limit=5

# --- Auth ---
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production

# --- AI Provider ---
AI_PROVIDER=gemini
GEMINI_API_KEY=

# --- Environment ---
NODE_ENV=development

# --- Catálogo / ERP (transitorio: pasará a configuración por tenant) ---
# Sin valor por defecto: si falta CATALOG_API_KEY el catálogo responde 503.
CATALOG_API_URL=
CATALOG_API_KEY=
# Nombres de parámetro que acepta el ERP para búsqueda por texto (orden de intento)
CATALOG_TEXT_PARAMS=clave,q,descripcion,search
