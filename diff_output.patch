++      } else if (error.status === 400 && Array.isArray(error.data?.errors)) {
++        // map field errors
++        error.data.errors.forEach(err => {
++          if (err.path && err.path[0]) {
++            setError(err.path[0], { type: 'manual', message: err.message });
++          }
++        });
