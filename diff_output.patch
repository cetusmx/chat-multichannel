++# Build stage
++FROM node:22-alpine AS build
++
++WORKDIR /app
++
++# Install dependencies
++COPY package*.json ./
++RUN npm ci
++
++# Copy source and build
++COPY . .
++ARG VITE_API_URL
++ENV VITE_API_URL=$VITE_API_URL
++RUN npm run build
++
++# Serve stage
++FROM nginx:alpine
++
++# Copy custom nginx config
