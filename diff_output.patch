++      return text ? JSON.parse(text) : null;
++    } catch (e) {
++      return null;
++    }
++  },
++
++  get(endpoint, options) {
++    return this.fetch(endpoint, { ...options, method: 'GET' });
++  },
++
++  post(endpoint, body, options) {
