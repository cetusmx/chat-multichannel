++const { getTenantStatus, setTenantStatus, invalidateTenantCache, getTenantStatusAsync } = require('../../src/utils/tenant-cache.util');
++const prisma = require('../../src/config/database');
++
++jest.mock('../../src/config/database', () => ({
++  tenant: {
++    findUnique: jest.fn(),
