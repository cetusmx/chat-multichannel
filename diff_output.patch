++    const user = await tx.user.create({
++      data: {
++        name: adminName,
++        email: adminEmail,
++        passwordHash,
++        role: 'ADMIN',
++        tenantId: tenant.id,
++        isActive: true,
++        emailVerified: new Date(),
++      },
++    });
++
++    return { tenant, user };
++  }, { timeout: 10000 });
++}
++
++/**
++ * Updates the status of a tenant.
++ *
++ * @param {string} id Tenant ID
