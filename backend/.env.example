DATABASE_URL="postgresql://user:password@localhost:5432/salesflow"
JWT_SECRET=your-jwt-secret
JWT_REFRESH_SECRET=your-refresh-secret
ENCRYPTION_KEY=12345678901234567890123456789012
AI_PROVIDER=gemini

# --- Catálogo / ERP (transitorio: pasará a configuración por tenant) ---
# Sin valor por defecto: si falta CATALOG_API_KEY el catálogo responde 503.
CATALOG_API_URL=
CATALOG_API_KEY=
# Nombres de parámetro que acepta el ERP para búsqueda por texto (orden de intento)
CATALOG_TEXT_PARAMS=clave,q,descripcion,search
