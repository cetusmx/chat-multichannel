# ===== Identidad del stack =====
CLIENT_SLUG=acme                       # minúsculas, sin espacios; nombra contenedores y volúmenes
APP_DOMAIN=acme.salesflow.mx           # DNS A/AAAA apuntando al host del proxy
# SUPERADMIN_DOMAIN=admin.acme.salesflow.mx   # solo si se activa el perfil superadmin

# ===== Imagen =====
APP_IMAGE=ghcr.io/cetusmx/salesflow-app:latest        # fija una etiqueta de versión en producción
# SUPERADMIN_IMAGE=ghcr.io/cetusmx/salesflow-superadmin:latest

# ===== Base de datos (propia del cliente) =====
POSTGRES_USER=salesflow
POSTGRES_PASSWORD=__GENERATED__
POSTGRES_DB=salesflow
DB_CONNECTION_LIMIT=5
DB_MEM_LIMIT=512m
APP_MEM_LIMIT=1g

# ===== Secretos de la aplicación (únicos por cliente) =====
JWT_SECRET=__GENERATED__
JWT_REFRESH_SECRET=__GENERATED__
SUPERADMIN_JWT_SECRET=__GENERATED__
ENCRYPTION_KEY=__GENERATED_32__        # exactamente 32 caracteres; cifra API keys (IA, catálogo)

# ===== Proveedores =====
AI_PROVIDER=gemini
GEMINI_API_KEY=                        # opcional: la clave de IA se configura por tenant desde la app
FIREBASE_SERVICE_ACCOUNT=              # opcional: push a la app móvil (JSON en una línea)

# ===== Primer arranque: tenant y administrador =====
TENANT_NAME=ACME Refacciones
TENANT_ADMIN_NAME=Administrador
TENANT_ADMIN_EMAIL=admin@acme.mx
TENANT_ADMIN_PASSWORD=__GENERATED__
# TENANT_MAX_USERS=10
# TENANT_MAX_AI_TOKENS=-1
# Catálogo inicial (JSON en una línea, misma forma que Configuración → Catálogo). Opcional.
# TENANT_CATALOG_CONFIG_JSON={"provider":"generic_rest","baseUrl":"https://erp.acme.mx","apiKey":"...","connection":{"search":{"path":"/api/products","resultsPath":"data"}}}

# ===== Superadmin del stack (opcional; necesario para el perfil superadmin) =====
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
# SUPERADMIN_RESET_PASSWORD=true       # un solo arranque para restablecer; luego quitar
